! 50 indicate poor analogy and mandate extensive validation/optimization.

RESI PHEN         -1.000 ! param penalty=   0.000 ; charge penalty=   0.000
GROUP            ! CHARGE   CH_PENALTY
ATOM C1     CG2R61 -0.599 !    0.000
ATOM C2     CG2R61 -0.115 !    0.000
ATOM C3     CG2R61  0.400 !    0.000
ATOM C4     CG2R61 -0.599 !    0.000
ATOM C5     CG2R61 -0.115 !    0.000
ATOM C6     CG2R61 -0.115 !    0.000
ATOM O      OG312  -0.762 !    0.000
ATOM H01    HGR61   0.280 !    0.000
ATOM H02    HGR61   0.115 !    0.000
ATOM H03    HGR61   0.280 !    0.000
ATOM H04    HGR61   0.115 !    0.000
ATOM H05    HGR61   0.115 !    0.000

BOND C1   C2  
BOND C1   H01 
BOND C2   H02 
BOND C1   C3  
BOND C3   C4  
BOND C4   C5  
BOND C4   H03 
BOND C5   C6  
BOND C5   H04 
BOND C2   C6  
BOND C6   H05 
